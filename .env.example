# =============================================================================
# Copy this file to `.env` and fill in the values.
# Never commit `.env` (it is gitignored).
#
# Linear is not part of this product. Do not add LINEAR_* keys.
# =============================================================================


# -----------------------------------------------------------------------------
# 1) FRONTEND (Vite) — Settings → API Keys / JWT Keys + General
#    Dashboard: https://supabase.com/dashboard → your project → Settings
# -----------------------------------------------------------------------------

# Settings → General → Reference ID  (also the subdomain of the Project URL)
VITE_SUPABASE_PROJECT_ID=

# Settings → General → Project URL
# Example: https://abcdefghijklmnop.supabase.co
VITE_SUPABASE_URL=

# Public browser key. Prefer Settings → JWT Keys → `anon` / `legacy anon`
# (starts with eyJ...). If that page only shows the new key, use
# Settings → API Keys → Publishable key (starts with sb_publishable_).
# NEVER put a Secret key (sb_secret_...) or service_role key here.
VITE_SUPABASE_PUBLISHABLE_KEY=


# -----------------------------------------------------------------------------
# 2) GOOGLE OAUTH — Google Cloud Console, then paste into Supabase
#    https://console.cloud.google.com
#
#    Enable: Google Drive API, Google Docs API
#    Create: APIs & Services → Credentials → OAuth 2.0 Client ID (Web)
#    Authorized redirect URI (must match Supabase, not localhost):
#      https://<VITE_SUPABASE_PROJECT_ID>.supabase.co/auth/v1/callback
#
#    Then in Supabase: Authentication → Providers → Google
#      - Enable Google
#      - Paste Client ID + Client Secret
#      - Site URL: http://localhost:5173  (add production URL later)
#      - Redirect URLs: http://localhost:5173/auth/callback
#
#    Also set the same Client ID/Secret as Edge Function secrets (section 3).
# -----------------------------------------------------------------------------

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=


# -----------------------------------------------------------------------------
# 3) SUPABASE EDGE FUNCTION SECRETS
#    These are NOT used by Vite. After filling `.env`, also run:
#      supabase secrets set --env-file .env
#    or paste them in: Project Settings → Edge Functions → Secrets
#
#    Supabase injects these automatically (do not put them in `.env`):
#      SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY
# -----------------------------------------------------------------------------

# https://platform.openai.com/api-keys
# Used for embeddings (text-embedding-3-small) during index + search
OPENAI_API_KEY=

# https://console.anthropic.com/settings/keys
# Used for search synthesis, query expansion, text-to-SQL
ANTHROPIC_API_KEY=

# Settings → Database → Connect → URI (direct connection, not pooler)
# Needed for spreadsheet materialization / text-to-SQL.
# Supabase forbids custom secrets named SUPABASE_*. Use DATABASE_URL in
# Edge Function secrets (same URI). Local scripts also accept SUPABASE_DB_URL.
DATABASE_URL=

# Optional — only if you swap the LLM off Anthropic
# LLM_PROVIDER=openrouter
# LLM_MODEL=
# OPENROUTER_API_KEY=

# Optional feature flags (all default off). Set to true to enable.
# ENABLE_SQL_ROUTER=false
# ENABLE_HYBRID=false
# MATERIALIZE_SHEETS=false
# SQL_USER_ALLOWLIST=


# -----------------------------------------------------------------------------
# 4) EVALS ONLY (Deno) — copy the same values; used by evals/run-evals.ts
#    Settings → JWT Keys → `anon`  → SUPABASE_ANON_KEY
#    Settings → JWT Keys → `service_role`  → SUPABASE_SERVICE_ROLE_KEY
#    (service_role is a secret — never expose it in the browser)
# -----------------------------------------------------------------------------

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
EVAL_USER_EMAIL=
EVAL_USER_PASSWORD=
